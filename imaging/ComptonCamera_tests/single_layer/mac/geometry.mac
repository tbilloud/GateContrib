#======== World=================
/gate/world/geometry/setXLength 200 mm
/gate/world/geometry/setYLength 200 mm
/gate/world/geometry/setZLength 200 mm
/gate/world/setMaterial         Vacuum

#======Boundary Box =====================
/gate/world/daughters/name                 BB
/gate/world/daughters/insert               box
/gate/BB/placement/setTranslation          0 0 48 mm
/gate/BB/geometry/setXLength               10 mm
/gate/BB/geometry/setYLength               10 mm
/gate/BB/geometry/setZLength               2 mm
/gate/BB/setMaterial                       Vacuum
/gate/BB/vis/setVisible                    1
/gate/BB/vis/setColor                      red

#==================== SCATTERER =========================
/gate/BB/daughters/name                    scatterer
/gate/BB/daughters/insert                  box
/gate/scatterer/placement/setTranslation   0 0 -0.5 mm
/gate/scatterer/geometry/setXLength        10 mm
/gate/scatterer/geometry/setYLength        10 mm
/gate/scatterer/geometry/setZLength        1 mm
/gate/scatterer/setMaterial                Vacuum

#================== ABSORBER =============================
/gate/BB/daughters/name                    absorber
/gate/BB/daughters/insert                  box
/gate/absorber/placement/setTranslation    0 0 0.5 mm
/gate/absorber/geometry/setXLength         10 mm
/gate/absorber/geometry/setYLength         10 mm
/gate/absorber/geometry/setZLength         1 mm
/gate/absorber/setMaterial                 CdTe

#======Boundary Box =====================
/gate/world/daughters/name                 BB2
/gate/world/daughters/insert               box
/gate/BB2/placement/setTranslation          0 80 48 mm
/gate/BB2/geometry/setXLength               10 mm
/gate/BB2/geometry/setYLength               10 mm
/gate/BB2/geometry/setZLength               2 mm
/gate/BB2/setMaterial                       Vacuum
/gate/BB2/vis/setVisible                    1
/gate/BB2/vis/setColor                      red

#==================== SCATTERER =========================
/gate/BB2/daughters/name                    scatterer2
/gate/BB2/daughters/insert                  box
